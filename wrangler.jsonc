{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crosscoders",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-06-18",
  // Email goes out through the private crosscoders-mailer Worker (mailer/),
  // which holds the send_email binding Pages can't. Deploy the mailer first.
  "services": [
    { "binding": "MAILER", "service": "crosscoders-mailer" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crosscoders-gifts",
      "database_id": "80bd66ab-c846-470f-a242-3a2bf3cb354a"
    }
  ]
}
